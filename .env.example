# Ruta al JSON de credenciales de Firebase Admin SDK
FIREBASE_CREDENTIALS=ruta/al/service-account.json

# Web API Key de Firebase Authentication
FIREBASE_WEB_API_KEY=TU_WEB_API_KEY

# Configuracion SMTP para enviar los codigos de verificacion
# Gmail: smtp.gmail.com / 587
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=TU_APP_PASSWORD
MAIL_FROM=tu_correo@gmail.com
